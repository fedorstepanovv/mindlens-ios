// Non-secret configuration, committed deliberately.
//
// The API base URL is a public endpoint, not a credential — keeping it here means a
// fresh clone builds. Actual secrets (Firebase, RevenueCat, Sentry) belong in
// Config/Secrets.xcconfig, which is git-ignored. See Config/Secrets.example.xcconfig.

// xcconfig treats "//" as a comment even inside a value, so the scheme separator is
// spelled with a variable. This is the standard workaround, not a hack of ours.
URL_SCHEME_SEPARATOR = //

API_BASE_URL = https:$(URL_SCHEME_SEPARATOR)mindlens-api-production.up.railway.app

PRODUCT_BUNDLE_IDENTIFIER = com.trymindlensnative.mindlens
IPHONEOS_DEPLOYMENT_TARGET = 18.0
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
