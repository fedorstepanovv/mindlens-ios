<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Partial on purpose. GENERATE_INFOPLIST_FILE stays on and Xcode merges its keys into
     this dict, so the only thing here is what it will not carry: a *custom* key.
     INFOPLIST_KEY_<name> forwards only names on Xcode's own allowlist, and silently drops
     anything else — which is how this key resolved correctly in the build settings and never
     reached the bundle. $(API_BASE_URL) is substituted from Config/Base.xcconfig, which
     remains the single definition. -->
<plist version="1.0">
<dict>
	<key>MindlensAPIBaseURL</key>
	<string>$(API_BASE_URL)</string>
	<!-- Google Sign-In redirects to this custom scheme: the REVERSED_CLIENT_ID of the production
	     plist's iOS OAuth client for this bundle ID. A public value that ships in every build. The
	     SDK asserts it at the tap; Tools/check-build-settings.sh asserts it against the bundled
	     plist at build time. No GIDClientID here — the client ID is read from the plist itself. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>Google Sign-In</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.642843971268-ssie1juj6pqr46ch5k44hecb71arse7t</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
