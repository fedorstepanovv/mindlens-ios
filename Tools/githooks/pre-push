#!/bin/bash
# Runs before every push. Two refusals, both from ADR 0013:
#   main moves only by pull request — branch protection is a 403 on this plan, so this hook is
#   the only thing between a keyboard and main.
#   a push that would not fast-forward rewrites history someone may already have read.
# Nothing lifts either. MINDLENS_PUSH_MAIN=1 used to lift the first, "on the record" — the
# record was the terminal. main moves by pull request, no exceptions; a team gets the same rule
# from a ruleset. For the second, delete and recreate the branch instead.
set -uo pipefail
zero=0000000000000000000000000000000000000000

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = refs/heads/main ]; then
    echo "pre-push: main moves only by pull request — /pr land (ADR 0013). No override." >&2
    exit 1
  fi
  [ "$local_sha" = "$zero" ] && continue     # deleting a remote branch — /pr land does this
  [ "$remote_sha" = "$zero" ] && continue    # creating one
  if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
    echo "pre-push: $remote_ref would not fast-forward from ${remote_sha:0:7} — that rewrites pushed history. Not here (ADR 0013)." >&2
    exit 1
  fi
done
exit 0
